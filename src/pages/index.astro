---
import Layout from '../layouts/Layout.astro';
import GameCard from '../components/GameCard.astro';
import PageHero from '../components/PageHero.astro';
import EmptyState from '../components/EmptyState.astro';
import { getDatabase } from '../lib/db';
import { getAllGames } from '../lib/games';
import { getAllCategories } from '../lib/categories';
import { getAllPublishers } from '../lib/publishers';

export const prerender = true;

const games = await getAllGames(getDatabase());
const categories = await getAllCategories(getDatabase());
const publishers = await getAllPublishers(getDatabase());
---

<Layout title="Tailspin Toys - Crowdfunding your new favorite game!">
  <div class="py-8">
    <PageHero
      title="Welcome to Tailspin Toys"
      subtitle="Find your next game! And maybe even back one! Explore our collection!"
    />

    <div>
      <h2 class="text-2xl font-medium mb-6 text-slate-100">Featured Games</h2>

      <form
        class="mb-8 grid gap-4 rounded-xl border border-slate-700 bg-slate-800/60 p-6 sm:grid-cols-2"
        data-testid="game-filters"
        aria-label="Filter games"
      >
        <fieldset>
          <legend class="mb-2 text-sm font-medium text-slate-200">
            <label for="category-filter">Categories</label>
          </legend>
          <select
            id="category-filter"
            name="categories"
            multiple
            class="min-h-32 w-full rounded-lg border border-slate-600 bg-slate-900 px-3 py-2 text-slate-100 focus:ring-2 focus:ring-blue-500 focus:outline-none"
            data-testid="category-filter"
            aria-describedby="category-filter-help"
          >
            {categories.map((category) => (
              <option value={category.id}>{category.name}</option>
            ))}
          </select>
          <p id="category-filter-help" class="mt-2 text-sm text-slate-400">
            Select one or more categories.
          </p>
        </fieldset>

        <div>
          <label for="publisher-filter" class="mb-2 block text-sm font-medium text-slate-200">
            Publisher
          </label>
          <select
            id="publisher-filter"
            name="publisher"
            class="w-full rounded-lg border border-slate-600 bg-slate-900 px-3 py-2 text-slate-100 focus:ring-2 focus:ring-blue-500 focus:outline-none"
            data-testid="publisher-filter"
          >
            <option value="">All publishers</option>
            {publishers.map((publisher) => (
              <option value={publisher.id}>{publisher.name}</option>
            ))}
          </select>
        </div>

        <button
          type="reset"
          class="w-fit rounded-lg border border-slate-600 px-4 py-2 text-sm font-medium text-slate-200 transition-colors hover:bg-slate-700 focus:ring-2 focus:ring-blue-500 focus:outline-none"
          data-testid="reset-filters"
        >
          Clear filters
        </button>
      </form>

      {games.length === 0 ? (
        <EmptyState text="No games available at the moment." />
      ) : (
        <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3" data-testid="games-grid">
          {games.map((game) => <GameCard game={game} />)}
        </div>
      )}

      <div class="hidden" data-testid="filtered-empty-state">
        <EmptyState text="No games match the selected filters." />
      </div>
    </div>
  </div>
</Layout>

<script>
  const filterForm = document.querySelector<HTMLFormElement>('[data-testid="game-filters"]');
  const gamesGrid = document.querySelector<HTMLElement>('[data-testid="games-grid"]');
  const filteredEmptyState = document.querySelector<HTMLElement>('[data-testid="filtered-empty-state"]');

  if (filterForm && gamesGrid && filteredEmptyState) {
    const categoryFilter = filterForm.querySelector<HTMLSelectElement>('[data-testid="category-filter"]');
    const publisherFilter = filterForm.querySelector<HTMLSelectElement>('[data-testid="publisher-filter"]');
    const gameCards = Array.from(gamesGrid.querySelectorAll<HTMLElement>('[data-testid="game-card"]'));

    const updateResults = (): void => {
      const selectedCategories = new Set(
        Array.from(categoryFilter?.selectedOptions ?? [], (option) => option.value),
      );
      const selectedPublisher = publisherFilter?.value ?? '';
      let visibleGames = 0;

      for (const gameCard of gameCards) {
        const categoryId = gameCard.dataset.categoryId ?? '';
        const publisherId = gameCard.dataset.publisherId ?? '';
        const matchesCategory =
          selectedCategories.size === 0 || selectedCategories.has(categoryId);
        const matchesPublisher = selectedPublisher === '' || selectedPublisher === publisherId;
        const isVisible = matchesCategory && matchesPublisher;

        gameCard.classList.toggle('hidden', !isVisible);
        if (isVisible) {
          visibleGames += 1;
        }
      }

      gamesGrid.classList.toggle('hidden', visibleGames === 0);
      filteredEmptyState.classList.toggle('hidden', visibleGames !== 0);
    };

    filterForm.addEventListener('change', updateResults);
    filterForm.addEventListener('reset', () => requestAnimationFrame(updateResults));
  }
</script>
